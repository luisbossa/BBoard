<link rel="stylesheet" href="<%= asset('/css/profile.css') %>">
<div class="main-content">
    <div class="box profile-box">
        <div class="dashboard-card-header">Mi perfil</div>

        <div class="profile-grid">
            <!-- FOTO -->
            <div class="profile-photo-card">
                <form method="POST" action="/dashboard/profile/avatar" enctype="multipart/form-data" id="avatar-form">
                    <div class="profile-avatar-wrapper">
                        <img src="<%= currentUser.avatar || '/images/user-default.webp' %>" class="profile-avatar" alt="Foto de perfil">
                        <label class="avatar-overlay" title="Cambiar foto">
                            <span class="material-symbols-rounded">photo_camera</span>
                            <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" hidden
                                onchange="this.form.submit()">
                        </label>
                    </div>
                </form>
                <div class="profile-role">
                    <span class="status paid"><%= fmt.ROLE[currentUser.role] %></span>
                </div>
                <p class="text-second">Usuario: <strong><%= currentUser.username %></strong></p>
                <p class="text-second">Último acceso: <%= fmt.dateTime(currentUser.last_login_at) %></p>
            </div>

            <div class="profile-form-card">
                <!-- DATOS -->
                <form method="POST" action="/dashboard/profile" class="stack-form">
                    <div class="field-title">Datos personales</div>
                    <div class="form-grid">
                        <label>Nombre completo
                            <input type="text" name="full_name" value="<%= currentUser.full_name %>" required maxlength="120">
                        </label>
                        <label>Correo <span class="text-second">— para recuperar la contraseña</span>
                            <input type="email" name="email" value="<%= currentUser.email || '' %>" maxlength="255">
                        </label>
                    </div>
                    <% if (!currentUser.email) { %>
                        <p class="hint warning">Agrega un correo: sin él no podrás recuperar tu contraseña si la olvidas.</p>
                    <% } %>
                    <button type="submit" class="btn-primary">Guardar datos</button>
                </form>

                <!-- CONTRASEÑA -->
                <form method="POST" action="/dashboard/profile/password" class="stack-form">
                    <div class="field-title">Cambiar contraseña</div>
                    <div class="form-grid">
                        <label>Contraseña actual
                            <input type="password" name="current_password" required autocomplete="current-password">
                        </label>
                        <label>Nueva contraseña <span class="text-second">— mínimo 8</span>
                            <input type="password" name="password" required minlength="8" autocomplete="new-password">
                        </label>
                        <label>Confirmar
                            <input type="password" name="confirm" required minlength="8" autocomplete="new-password">
                        </label>
                    </div>
                    <button type="submit" class="btn-primary">Actualizar contraseña</button>
                </form>
            </div>
        </div>
    </div>
</div>
