<%
  const s = summary;
  const tiles = [
    ["Ingresos cobrados", fmt.money(s.revenue)],
    ["Ventas", s.sales],
    ["Ticket promedio", fmt.money(s.avg_ticket)],
    ["Clientes", s.customers],
  ];
  // Barra horizontal: proporción contra el máximo de la lista.
  const bars = (rows, key) => {
    const max = Math.max(1, ...rows.map(r => r[key]));
    return rows.map(r => ({ ...r, pct: Math.round((r[key] / max) * 100) }));
  };
%>
<div class="main-content">
    <div class="box">
        <div class="dashboard-card-header header-flex">
            <span class="title">Analíticas de ventas</span>
            <nav class="tabs compact" aria-label="Rango de fechas">
                <% ranges.forEach(r => { %>
                    <a href="?days=<%= r %>" class="<%= range === r ? 'active' : '' %>"><%= r === 365 ? "1 año" : `${r} días` %></a>
                <% }) %>
            </nav>
        </div>
        <p class="hint">Solo cuentan pedidos cobrados (pagados, enviados o entregados) de los últimos <%= range %> días, en hora de Costa Rica.</p>
    </div>

    <div class="row">
        <% tiles.forEach(([label, value]) => { %>
            <div class="col-3 col-md-6 col-sm-12">
                <div class="box">
                    <div class="counter-title"><%= label %></div>
                    <div class="counter-count small"><%= value %></div>
                </div>
            </div>
        <% }) %>
    </div>

    <div class="box">
        <div class="dashboard-card-header">Ingresos por <%= bucket === "week" ? "semana" : "día" %></div>
        <%
          const dayLabel = (d) => `${d.slice(8, 10)}/${d.slice(5, 7)}`;
          const points = daily.map(d => ({
            label: dayLabel(d.day),
            title: `${bucket === "week" ? "Semana del " : ""}${dayLabel(d.day)}: ${fmt.money(d.revenue)} · ${d.sales} venta${d.sales === 1 ? "" : "s"}`,
            values: [d.revenue],
          }));
        %>
        <figure class="chart">
            <%- include("partials/bar-chart", {
                points,
                series: [{ name: "Ingresos", className: "chart__bar--single" }],
                yFormat: "money",
                labelEvery: Math.max(1, Math.ceil(points.length / 8)),
                width: 1100,
                height: 300,
                ariaLabel: `Ingresos por ${bucket === "week" ? "semana" : "día"} de los últimos ${range} días. Ver tabla para los valores.`,
            }) %>
        </figure>
        <details class="table-view">
            <summary>Ver como tabla</summary>
            <table class="data-table compact">
                <thead><tr><th><%= bucket === "week" ? "Semana del" : "Día" %></th><th class="right">Ventas</th><th class="right">Ingresos</th></tr></thead>
                <tbody>
                    <% daily.filter(d => d.sales).reverse().forEach(d => { %>
                        <tr><td><%= d.day %></td><td class="right"><%= d.sales %></td><td class="right"><%= fmt.money(d.revenue) %></td></tr>
                    <% }) %>
                </tbody>
            </table>
        </details>
    </div>

    <div class="row">
        <% [
            ["Métodos de pago", bars(methods, "revenue"), r => fmt.payment(r.method), r => `${fmt.money(r.revenue)} · ${r.sales} venta${r.sales === 1 ? '' : 's'}`],
            ["Top provincias", bars(provinces, "sales"), r => r.province, r => `${r.sales} venta${r.sales === 1 ? '' : 's'} · ${fmt.money(r.revenue)}`],
            ["Productos más vendidos", bars(products, "units"), r => r.name, r => `${r.units} u. · ${fmt.money(r.revenue)}`],
        ].forEach(([heading, rows, label, value]) => { %>
            <div class="col-4 col-md-6 col-sm-12">
                <div class="box">
                    <div class="dashboard-card-header"><%= heading %></div>
                    <% if (rows.length) { %>
                        <ul class="bar-list">
                            <% rows.forEach(r => { %>
                                <li>
                                    <div class="bar-label"><span><%= label(r) %></span><span class="text-second"><%= value(r) %></span></div>
                                    <div class="bar-track"><div class="bar-fill" style="width: <%= r.pct %>%"></div></div>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p class="empty">Sin ventas en este rango</p>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>

    <div class="box">
        <div class="dashboard-card-header">Pedidos por estado (todos los creados en el rango)</div>
        <div class="status-summary">
            <% Object.keys(fmt.ORDER_STATUS).forEach(st => { const row = statuses.find(x => x.status === st); %>
                <a href="/dashboard/orders?status=<%= st %>" class="status-count">
                    <%- include("partials/status", { status: st }) %>
                    <strong><%= row ? row.count : 0 %></strong>
                </a>
            <% }) %>
        </div>
    </div>
</div>
