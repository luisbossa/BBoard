<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title ? `${title} · ` : "" %>Panel 100Puntadas</title>
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <%- include("../partials/theme-head") %>
    <!-- Menú lateral contraído: se aplica antes de pintar para que no salte. -->
    <script>try { if (localStorage.getItem("sidebar") === "collapsed") document.documentElement.setAttribute("data-sidebar", "collapsed"); } catch (e) {}</script>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..24,400,0..1,0&display=block" rel="stylesheet">

    <link rel="stylesheet" href="<%= asset('/css/global.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/style.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/header.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/sidebar.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/grid.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/cards.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/main-table.css') %>">
    <link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
    <%- style %>
</head>

<body>
    <%- include("../partials/sidebar") %>

    <main class="main">
        <%- include("../partials/header") %>
        <%- include("../partials/flash") %>
        <%- body %>
    </main>

    <!-- Modal de confirmación (lo usa data-confirm en formularios y botones) -->
    <div id="confirm-modal" class="approve-modal hidden" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <div class="approve-box">
            <h3 class="approve-h3" id="confirm-title">¿Confirmar?</h3>
            <p id="confirm-text"></p>
            <div class="approve-actions">
                <button type="button" id="confirm-cancel" class="btn-cancel">Cancelar</button>
                <button type="button" id="confirm-ok" class="btn-confirm">Sí, continuar</button>
            </div>
        </div>
    </div>

    <div id="toast" class="approve-msg hidden" role="status"></div>

    <script src="<%= asset('/js/theme.js') %>"></script>
    <script src="<%= asset('/js/panel.js') %>"></script>
    <%- script %>
</body>

</html>
