<%
  const ACTION_LABELS = fmt.ACTIVITY;
  const describe = (a) => {
    const m = a.metadata || {};
    if (m.orderId) return `<a href="/dashboard/orders/${m.orderId}">#${m.orderNumber || m.orderId}</a>`;
    if (m.productId) return `<a href="/dashboard/products/${m.productId}/edit">${String(m.name || m.productId).replace(/</g, "&lt;")}</a>`;
    return "";
  };
%>
<div class="main-content">
    <div class="row">
        <div class="col-6 col-md-12 col-sm-12">
            <div class="box">
                <div class="dashboard-card-header">Pedidos (últimos movimientos)</div>
                <ul class="notification-page-list">
                    <% notifications.items.forEach(n => { %>
                        <li>
                            <a href="/dashboard/orders/<%= n.orderId %>" class="notification-item <%= n.type %>">
                                <span class="material-symbols-rounded"><%= n.icon %></span>
                                <div>
                                    <p><strong><%= n.message %></strong></p>
                                    <small><%= fmt.money(n.total) %> · <%= fmt.payment(n.paymentMethod) %> · <%= fmt.dateTime(n.date) %></small>
                                </div>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>
        <div class="col-6 col-md-12 col-sm-12">
            <div class="box">
                <div class="dashboard-card-header">Actividad del equipo</div>
                <% if (activity.length) { %>
                    <ul class="history">
                        <% activity.forEach(a => { %>
                            <li><strong><%= a.full_name %></strong> <%= ACTION_LABELS[a.action] || a.action %> <%- describe(a) %>
                                <% if (a.metadata?.reason) { %><span class="text-second">(<%= a.metadata.reason %>)</span><% } %>
                                <span class="text-second">· <%= fmt.dateTime(a.created_at) %></span></li>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p class="empty">Sin actividad registrada</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
