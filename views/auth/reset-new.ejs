<header class="card__header">
    <h1 class="card__title"><%= invalid ? "Enlace no válido" : "Nueva contraseña" %></h1>
    <p class="card__subtitle">
        <%= invalid
            ? "El enlace caducó o ya se usó. Pide uno nuevo para continuar."
            : "Elige una contraseña de al menos 8 caracteres." %>
    </p>
</header>

<% if (error) { %><%- include("../partials/alert", { type: "error", message: error }) %><% } %>

<% if (invalid) { %>
    <a class="btn btn--primary btn--block" href="/reset">Pedir un enlace nuevo</a>
<% } else { %>
    <form class="form" action="/reset/<%= token %>" method="POST" data-auth-form>
        <%- include("../partials/password-field", {
            id: "password", name: "password", label: "Nueva contraseña",
            autocomplete: "new-password", minlength: 8,
        }) %>
        <%- include("../partials/password-field", {
            id: "confirm", name: "confirm", label: "Confirmar contraseña",
            autocomplete: "new-password", minlength: 8,
        }) %>

        <button class="btn btn--primary btn--block" type="submit" data-loading-text="Guardando…">
            <span class="btn__label">Guardar contraseña</span>
        </button>
    </form>
<% } %>

<a class="link link--back" href="/">
    <span class="icon icon--sm" aria-hidden="true">arrow_back</span> Volver a iniciar sesión
</a>
