<header class="card__header">
    <h1 class="card__title">Inicia sesión</h1>
    <p class="card__subtitle">Ingresa con tu usuario del panel.</p>
</header>

<% if (success) { %><%- include("../partials/alert", { type: "success", message: success }) %><% } %>
<% if (error) { %><%- include("../partials/alert", { type: "error", message: error }) %><% } %>

<form class="form" action="/" method="POST" data-auth-form>
    <div class="field">
        <label class="field__label" for="username">Usuario</label>
        <div class="field__control">
            <span class="field__icon icon" aria-hidden="true">person</span>
            <input class="field__input" type="text" id="username" name="username" value="<%= username %>"
                placeholder="Tu usuario" autocomplete="username" autocapitalize="none" spellcheck="false"
                required <%= username ? "" : "autofocus" %> <%- error ? 'aria-invalid="true"' : "" %>>
        </div>
    </div>

    <%- include("../partials/password-field", {
        id: "password", name: "password", label: "Contraseña", autocomplete: "current-password",
    }) %>

    <div class="form__row">
        <label class="checkbox">
            <input class="checkbox__input" type="checkbox" name="remember" value="1">
            Recordarme 7 días
        </label>
        <a class="link" href="/reset">¿Olvidaste tu contraseña?</a>
    </div>

    <button class="btn btn--primary btn--block" type="submit" data-loading-text="Ingresando…">
        <span class="btn__label">Ingresar</span>
    </button>
</form>
