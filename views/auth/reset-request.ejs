<header class="card__header">
    <h1 class="card__title">Recupera tu contraseña</h1>
    <p class="card__subtitle">Escribe el correo de tu usuario y te enviaremos un enlace para crear una nueva.</p>
</header>

<% if (message) { %><%- include("../partials/alert", { type: "success", message }) %><% } %>
<% if (error) { %><%- include("../partials/alert", { type: "error", message: error }) %><% } %>

<% if (!message) { %>
    <form class="form" action="/reset" method="POST" data-auth-form>
        <div class="field">
            <label class="field__label" for="email">Correo electrónico</label>
            <div class="field__control">
                <span class="field__icon icon" aria-hidden="true">mail</span>
                <input class="field__input" type="email" id="email" name="email" placeholder="tu@correo.com"
                    autocomplete="email" required autofocus>
            </div>
        </div>

        <button class="btn btn--primary btn--block" type="submit" data-loading-text="Enviando…">
            <span class="btn__label">Enviar enlace</span>
        </button>
    </form>
<% } %>

<a class="link link--back" href="/">
    <span class="icon icon--sm" aria-hidden="true">arrow_back</span> Volver a iniciar sesión
</a>
