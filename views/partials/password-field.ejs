<%# Campo de contraseña con mostrar/ocultar y aviso de Bloq Mayús (auth.js).
    Parámetros: id, name, label, autocomplete, minlength (opcional). %>
<div class="field">
    <label class="field__label" for="<%= id %>"><%= label %></label>
    <div class="field__control">
        <span class="field__icon icon" aria-hidden="true">lock</span>
        <input class="field__input" type="password" id="<%= id %>" name="<%= name %>" required
            autocomplete="<%= autocomplete %>" placeholder="••••••••"
            <% if (typeof minlength !== "undefined") { %>minlength="<%= minlength %>"<% } %>
            aria-describedby="<%= id %>-caps">
        <button type="button" class="field__action" data-toggle-password="<%= id %>"
            aria-label="Mostrar contraseña" aria-pressed="false">
            <span class="icon" aria-hidden="true">visibility</span>
        </button>
    </div>
    <p class="field__hint field__hint--warning" id="<%= id %>-caps" data-capslock hidden>
        <span class="icon icon--sm" aria-hidden="true">keyboard_capslock</span>
        Bloq Mayús está activado
    </p>
</div>
