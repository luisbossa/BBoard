<% if (flash) { %>
    <div class="flash flash-<%= flash.type %>" role="alert">
        <span class="material-symbols-rounded">
            <%= flash.type === "success" ? "check_circle" : flash.type === "warning" ? "warning" : "error" %>
        </span>
        <span><%= flash.message %></span>
        <button type="button" class="flash-close" aria-label="Cerrar" onclick="this.parentElement.remove()">×</button>
    </div>
<% } %>
