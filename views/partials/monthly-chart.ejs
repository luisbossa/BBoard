<%#
  Gráfico de barras agrupadas: pedidos recibidos vs cobrados por mes.
  SVG generado en el servidor (sin librerías). Datos: monthly = [{ month: "2026-10", orders, paid, revenue }]
%>
<%
  const W = 440, H = 210;
  const pad = { top: 10, right: 4, bottom: 26, left: 26 };
  const plotW = W - pad.left - pad.right;
  const plotH = H - pad.top - pad.bottom;

  // Eje Y con números enteros "redondos".
  const rawMax = Math.max(1, ...monthly.map(m => m.orders));
  const step = Math.max(1, Math.ceil(rawMax / 4));
  const max = step * Math.ceil(rawMax / step);
  const ticks = []; for (let v = 0; v <= max; v += step) ticks.push(v);

  const y = (v) => pad.top + plotH - (v / max) * plotH;
  const group = plotW / monthly.length;
  const barW = Math.min(12, group * 0.32);
  const gap = 3;

  // Barra con esquinas superiores redondeadas, apoyada en la base.
  const bar = (x, value) => {
    if (!value) return "";
    const top = y(value), base = y(0), r = Math.min(4, barW / 2, base - top);
    return `M${x},${base}V${top + r}Q${x},${top} ${x + r},${top}H${x + barW - r}Q${x + barW},${top} ${x + barW},${top + r}V${base}Z`;
  };

  const monthName = (key, opts) => new Date(`${key}-15T12:00:00Z`).toLocaleDateString("es-CR", { timeZone: "UTC", ...opts });
%>
<figure class="chart">
    <ul class="chart__legend" aria-hidden="true">
        <li><span class="chart__swatch chart__swatch--orders"></span>Pedidos recibidos</li>
        <li><span class="chart__swatch chart__swatch--paid"></span>Pedidos cobrados</li>
    </ul>

    <svg class="chart__svg" viewBox="0 0 <%= W %> <%= H %>" role="img"
        aria-label="Pedidos recibidos y cobrados por mes, últimos <%= monthly.length %> meses. Ver tabla para los valores.">
        <% ticks.forEach(v => { %>
            <line class="chart__grid" x1="<%= pad.left %>" x2="<%= W - pad.right %>" y1="<%= y(v) %>" y2="<%= y(v) %>"></line>
            <text class="chart__axis" x="<%= pad.left - 8 %>" y="<%= y(v) + 4 %>" text-anchor="end"><%= v %></text>
        <% }) %>

        <% monthly.forEach((m, i) => {
             const gx = pad.left + i * group;
             const x1 = gx + group / 2 - barW - gap / 2;
             const x2 = gx + group / 2 + gap / 2; %>
            <g class="chart__group" tabindex="0">
                <title><%= monthName(m.month, { month: "long", year: "numeric" }) %>: <%= m.orders %> pedidos, <%= m.paid %> cobrados (<%= fmt.money(m.revenue) %>)</title>
                <rect class="chart__hit" x="<%= gx %>" y="<%= pad.top %>" width="<%= group %>" height="<%= plotH %>" rx="6"></rect>
                <path class="chart__bar chart__bar--orders" d="<%= bar(x1, m.orders) %>"></path>
                <path class="chart__bar chart__bar--paid" d="<%= bar(x2, m.paid) %>"></path>
                <text class="chart__axis" x="<%= gx + group / 2 %>" y="<%= H - 8 %>" text-anchor="middle"><%= monthName(m.month, { month: "short" }).replace(".", "") %></text>
            </g>
        <% }) %>
        <line class="chart__baseline" x1="<%= pad.left %>" x2="<%= W - pad.right %>" y1="<%= y(0) %>" y2="<%= y(0) %>"></line>
    </svg>

    <details class="chart__table">
        <summary>Ver como tabla</summary>
        <table class="data-table compact">
            <thead><tr><th>Mes</th><th class="right">Pedidos</th><th class="right">Cobrados</th><th class="right">Ingresos</th></tr></thead>
            <tbody>
                <% monthly.slice().reverse().forEach(m => { %>
                    <tr>
                        <td><%= monthName(m.month, { month: "long", year: "numeric" }) %></td>
                        <td class="right"><%= m.orders %></td>
                        <td class="right"><%= m.paid %></td>
                        <td class="right"><%= fmt.money(m.revenue) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </details>
</figure>
