<%#
  Dashboard: pedidos recibidos vs cobrados por mes (últimos 12).
  Datos: monthly = [{ month: "2026-10", orders, paid, revenue }]
%>
<%
  const monthName = (key, opts) => new Date(`${key}-15T12:00:00Z`).toLocaleDateString("es-CR", { timeZone: "UTC", ...opts });
  const points = monthly.map(m => ({
    label: monthName(m.month, { month: "short" }).replace(".", ""),
    title: `${monthName(m.month, { month: "long", year: "numeric" })}: ${m.orders} pedidos, ${m.paid} cobrados (${fmt.money(m.revenue)})`,
    values: [m.orders, m.paid],
  }));
%>
<figure class="chart">
    <ul class="chart__legend" aria-hidden="true">
        <li><span class="chart__swatch chart__swatch--orders"></span>Pedidos recibidos</li>
        <li><span class="chart__swatch chart__swatch--paid"></span>Pedidos cobrados</li>
    </ul>

    <%- include("bar-chart", {
        points,
        series: [{ name: "Pedidos", className: "chart__bar--orders" }, { name: "Cobrados", className: "chart__bar--paid" }],
        yFormat: "number",
        ariaLabel: `Pedidos recibidos y cobrados por mes, últimos ${monthly.length} meses. Ver tabla para los valores.`,
    }) %>

    <details class="chart__table">
        <summary>Ver como tabla</summary>
        <table class="data-table compact">
            <thead><tr><th>Mes</th><th class="right">Pedidos</th><th class="right">Cobrados</th><th class="right">Ingresos</th></tr></thead>
            <tbody>
                <% monthly.slice().reverse().forEach(m => { %>
                    <tr>
                        <td><%= monthName(m.month, { month: "long", year: "numeric" }) %></td>
                        <td class="right"><%= m.orders %></td>
                        <td class="right"><%= m.paid %></td>
                        <td class="right"><%= fmt.money(m.revenue) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </details>
</figure>
