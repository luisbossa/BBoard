<%
  const role = currentUser?.role;
  const links = [
    { href: "/dashboard", icon: "home", label: "Panel", exact: true },
    { href: "/dashboard/orders", icon: "receipt_long", label: "Pedidos" },
    { href: "/dashboard/customers", icon: "group", label: "Clientes" },
    { href: "/dashboard/products", icon: "storefront", label: "Productos" },
    { href: "/dashboard/analytics", icon: "analytics", label: "Analíticas" },
    { href: "/dashboard/notifications", icon: "notifications", label: "Actividad" },
    ...(role === "admin" ? [{ href: "/dashboard/users", icon: "admin_panel_settings", label: "Usuarios" }] : []),
    { href: "/dashboard/profile", icon: "person", label: "Mi perfil" },
  ];
  const isActive = (link) => link.exact ? originalUrl.split("?")[0] === link.href : originalUrl.startsWith(link.href);
%>
<div id="sidebar" class="sidebar">
    <div class="sidebar-logo">
        <img class="logo-img" src="/images/logo.png" alt="100Puntadas">
        <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Cerrar menú">
            <span class="material-symbols-rounded">close</span>
        </button>
    </div>

    <ul class="sidebar-menu">
        <% links.forEach(link => { %>
            <li>
                <a href="<%= link.href %>" class="<%= isActive(link) ? 'active' : '' %>">
                    <span class="material-symbols-rounded"><%= link.icon %></span>
                    <span class="sidebar-text"><%= link.label %></span>
                </a>
            </li>
        <% }) %>

        <li>
            <a href="<%= storeUrl %>" target="_blank" rel="noopener">
                <span class="material-symbols-rounded">open_in_new</span>
                <span class="sidebar-text">Ver tienda</span>
            </a>
        </li>

        <li>
            <a href="#" class="darkmode-toggle" id="darkmode-toggle">
                <span class="material-symbols-rounded">dark_mode</span>
                <span class="sidebar-text">Modo oscuro</span>
                <span class="darkmode-switch"></span>
            </a>
        </li>
    </ul>

    <footer class="footer">
        <div>
            100Puntadas ©
            <br><span class="full-text">Panel administrativo <%= new Date().getFullYear() %></span>
        </div>
    </footer>
</div>
