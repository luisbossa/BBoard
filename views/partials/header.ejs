<div class="main-header">
    <div class="mobile-toggle" id="mobile-toggle">
        <button type="button" id="mobile-btn" class="mobile-btn" aria-label="Abrir menú">
            <span class="material-symbols-rounded">menu</span>
        </button>
    </div>

    <button type="button" id="sidebar-btn" class="sidebar-btn" aria-label="Contraer menú">
        <span class="material-symbols-rounded">menu</span>
    </button>

    <div class="user-div">
        <!-- TEMA: claro / oscuro / sistema (lógica en panel.js) -->
        <div class="theme-menu" id="themeMenu">
            <button type="button" class="icon-btn" id="themeBtn" aria-haspopup="menu" aria-expanded="false"
                aria-controls="themeOptions" aria-label="Cambiar tema" title="Tema">
                <span class="material-symbols-rounded" id="themeIcon" aria-hidden="true">contrast</span>
            </button>
            <div class="menu-dropdown" id="themeOptions" role="menu" aria-label="Tema">
                <% [["light", "light_mode", "Claro"], ["dark", "dark_mode", "Oscuro"], ["system", "contrast", "Según el sistema"]].forEach(([value, icon, label]) => { %>
                    <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="<%= value %>">
                        <span class="material-symbols-rounded" aria-hidden="true"><%= icon %></span>
                        <span><%= label %></span>
                        <span class="material-symbols-rounded menu-check" aria-hidden="true">check</span>
                    </button>
                <% }) %>
            </div>
        </div>

        <!-- NOTIFICACIONES (se cargan desde /dashboard/api/notifications) -->
        <div class="notification-button" id="notificationBtn" role="button" tabindex="0" aria-label="Notificaciones">
            <span class="material-symbols-rounded">notifications</span>
            <div class="notification-badge hidden">0</div>

            <div class="notification-dropdown">
                <div class="notification-header">
                    <span>Notificaciones</span>
                    <small></small>
                </div>
                <ul class="notification-list"></ul>
                <a href="/dashboard/notifications" class="notification-footer">Ver toda la actividad</a>
            </div>
        </div>

        <a href="/dashboard/profile" class="user-link">
            <span class="user-name"><%= currentUser.full_name %></span>
            <div class="user-img"
                style="background-image: url('<%= currentUser.avatar || '/images/user-default.webp' %>')"></div>
        </a>

        <a class="logout-btn" href="/logout">
            <span class="material-symbols-rounded tiny-icon">logout</span>
            <span class="logout-span">Salir</span>
        </a>
    </div>
</div>
