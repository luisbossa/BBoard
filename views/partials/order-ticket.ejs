<%
  const orderNo = order.orderNumber || order.id;
  const shippingText = order.shipping > 0 ? `Correos de CR ${fmt.money(order.shipping)}` : "Retiro en tienda";
  const variant = (item) => [
    item.size && `Talla ${item.size}`,
    item.topSize && `Top ${item.topSize}`,
    item.bottomSize && `Bottom ${item.bottomSize}`,
    item.bottomStyle && `Estilo ${item.bottomStyle}`,
    item.color && `Color ${item.color}`,
  ].filter(Boolean).join(" · ");

  // Hoja del pedido para el taller (WhatsApp de la tienda).
  const sheet = [
    `ORDEN DE PEDIDO #${orderNo}`,
    `Cliente: ${order.client} · ${order.phone}`,
    "",
    ...order.items.map(i => `• ${i.quantity}x ${i.productName}${variant(i) ? ` (${variant(i)})` : ""}`),
    "",
    "DIRECCIÓN",
    `${order.province}, ${order.canton}, ${order.district}`,
    order.neighborhood || "",
    order.address,
    "",
    `Pago: ${fmt.payment(order.paymentMethod)} · Envío: ${shippingText}`,
    `Total: ${fmt.money(order.total)}`,
  ].join("\n");
  const clientPhone = `506${String(order.phone || "").replace(/\D/g, "")}`;
%>
<div class="order-ticket gridcolums-4" data-order-id="<%= order.id %>">

    <!-- COLUMNA 1: PEDIDO -->
    <div class="order-col">
        <a class="order-number" href="/dashboard/orders/<%= order.id %>">Pedido #<%= orderNo %></a>
        <div class="order-date"><%= fmt.dateTime(order.createdAt) %></div>
        <%- include("status", { status: order.status }) %>

        <div class="order-payment">Pago: <%= fmt.payment(order.paymentMethod) %></div>
        <div class="order-shipping">Envío: <%= shippingText %></div>

        <div class="order-summary">
            <div>Artículos: <strong><%= order.totalItems %></strong></div>
            <div>Total: <strong><%= fmt.money(order.total) %></strong></div>
        </div>

        <div class="order-actions no-print">
            <a href="https://wa.me/<%= storeWhatsapp %>?text=<%= encodeURIComponent(sheet) %>" target="_blank" rel="noopener"
                class="btn-action whatsapp" title="Enviar hoja del pedido al WhatsApp de la tienda">WhatsApp</a>
            <a href="https://wa.me/<%= clientPhone %>" target="_blank" rel="noopener" class="btn-action whatsapp"
                title="Escribir al cliente">Cliente</a>
            <button type="button" class="btn-action print" data-print>Imprimir</button>
            <%- include("order-actions", { order }) %>
        </div>
    </div>

    <!-- COLUMNA 2: CLIENTE -->
    <div class="order-col">
        <div class="order-client">
            <a href="/dashboard/customers/<%= encodeURIComponent(order.email.toLowerCase()) %>"><strong><%= order.client %></strong></a>
        </div>
        <div class="order-id">Céd: <%= order.nationalId %></div>
        <div class="order-phone">Cel: <%= order.phone %></div>
        <div class="order-email"><%= order.email %></div>
    </div>

    <!-- COLUMNA 3: DIRECCIÓN -->
    <div class="order-col">
        <div class="order-address">
            <strong><%= order.province %></strong>, <%= order.canton %>, <%= order.district %>
        </div>
        <% if (order.neighborhood) { %><div class="order-neighborhood">Barrio: <%= order.neighborhood %></div><% } %>
        <div class="order-address-detail"><%= order.address %></div>
        <% if (order.addressDetails) { %><div class="text-second"><%= order.addressDetails %></div><% } %>
    </div>

    <!-- COLUMNA 4: PRODUCTOS -->
    <div class="order-col gap-col">
        <% if (order.items.length) { %>
            <% order.items.forEach(item => { %>
                <div class="ticket-item">
                    <img src="<%= fmt.storeImage(item.image) %>" alt="" loading="lazy">
                    <div>
                        <strong><%= item.productName %></strong>
                        <div><%= item.quantity %> × <%= fmt.money(item.price) %></div>
                        <% if (variant(item)) { %><div class="text-second"><%= variant(item) %></div><% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <span class="muted">Sin productos</span>
        <% } %>
    </div>
</div>
