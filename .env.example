# Base de datos (la misma Neon que usa la tienda 100puntadas)
DATABASE_URL=postgresql://usuario:clave@host/100puntadas?sslmode=require

# Firma de las sesiones del panel (cadena larga y aleatoria)
JWT_SECRET=

# URL pública de este panel (enlaces de recuperación de contraseña)
APP_URL=http://localhost:3001

# Tienda: imágenes con ruta relativa y webhook de pago SINPE
STORE_URL=https://100puntadas.vercel.app
# Debe ser igual a SINPE_WEBHOOK_SECRET en la tienda
SINPE_WEBHOOK_SECRET=

# Vercel Blob (imágenes de productos y fotos de perfil)
BLOB_READ_WRITE_TOKEN=

# Gmail con contraseña de aplicación (recuperación de contraseña)
MAIL_USER=
MAIL_PASS=

NODE_ENV=development
PORT=3001
